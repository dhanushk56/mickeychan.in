# --- Admin password (required for /admin and /form-builder) ---
# One shared password unlocks both the admin console and the form builder.
# Set this in your host's environment settings (Vercel → Settings → Environment
# Variables) or in .env.local for local development. Never commit real values.
ADMIN_PASSWORD=

# Random long string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# If omitted, ADMIN_PASSWORD is used as the signing key.
SESSION_SECRET=

# --- Vercel KV (required for persistence in production) ---
# These are injected automatically once you create a KV database in the
# Vercel dashboard (Storage tab -> Create Database -> KV) and connect it
# to this project. You don't need to set them by hand on Vercel — only
# for local dev against a real KV store, if you want that.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Google sign-in (optional) ---
# Create an OAuth client in Google Cloud Console, add
# https://mickeychan.in/api/auth/google/callback as an authorised redirect
# URI, then paste the client id and secret here. Only the scopes
# openid, email and profile are requested, so no Google review is needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed if the redirect URI differs from the site URL above.
GOOGLE_REDIRECT_URI=

# --- Confirmation email (required for username/password sign-up) ---
# An API key from resend.com. Without it, username/password sign-up is paused
# because new accounts must confirm their address before they can log in.
RESEND_API_KEY=
# Optional: a verified sender at your own domain. Defaults to
# Mickey Chan <noreply@mickeychan.in>.
MAIL_FROM=

# --- Public site origin (optional) ---
# Used to build confirmation links. Defaults to the request's own host.
SITE_URL=
