# --- Discord OAuth (required for /admin and /form-builder) ---
# Create an application at https://discord.com/developers/applications,
# add a redirect URI of  https://YOUR_DOMAIN/api/auth/discord/callback
# (and http://localhost:3000/api/auth/discord/callback for local dev).
DISCORD_CLIENT_ID=1529489045032403094
DISCORD_CLIENT_SECRET=g4Wx2PYMs8F_QCtgX_qMdRsmgscCgb-5

# Comma-separated list of Discord user IDs allowed into /admin and /form-builder.
# Right-click your own username in Discord (with Developer Mode on) -> Copy User ID.
ALLOWED_DISCORD_IDS=1077905352244338688

# Random long string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Vercel KV (required for persistence in production) ---
# These are injected automatically once you create a KV database in the
# Vercel dashboard (Storage tab -> Create Database -> KV) and connect it
# to this project. You don't need to set them by hand on Vercel — only
# for local dev against a real KV store, if you want that.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- YouTube Data API (required to load all uploads and view counts) ---
# Create an API key in Google Cloud Console and enable the YouTube Data API v3.
YOUTUBE_API_KEY=
